{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}+BTW-${btw_version}",
  "name": "${name}",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "sources": "https://github.com/Legacy-Fabric/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/buildcraft/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [

    ],
    "btw:addon": [

    ]
  },
  "custom": {
    "btw:addon_prefix": "EX",
