      "net/minecraft/class_1150": ["dev/bagel/buildcraft/extensions/IBlockAccessExtension"],
      "net/minecraft/class_1158": ["dev/bagel/buildcraft/extensions/IBlockAccessExtension"],
      "net/minecraft/class_474": ["dev/bagel/buildcraft/extensions/NBTTagListExtension"],
      "net/minecraft/class_1069": ["dev/bagel/buildcraft/extensions/ItemExtension"],
      "net/minecraft/class_197": ["dev/bagel/buildcraft/extensions/BlockExtension"]
    }
  },
  "mixins": [
    "buildcraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "${minecraft_version}",
    "btw": ">=${btw_version}"
